@inherits LayoutComponentBase

<div class="site">
    <NavMenu />

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <p class="footer-brand">EMM Welding</p>
                <p>Structural, fabrication &amp; mobile welding.</p>
            </div>
            <div>
                @* TODO: replace with the client's real contact details *@
                <p>Phone: (555) 555-0123</p>
                <p>Email: info@example.com</p>
            </div>
            <div>
                <a class="btn btn-primary" href="quote">Request a Quote</a>
            </div>
        </div>
        <p class="container copyright">&copy; @DateTime.Now.Year EMM Welding. All rights reserved.</p>
    </footer>
</div>

@* Blazor shows this bar automatically if something breaks in an interactive component. *@
<div id="blazor-error-ui" data-nosnippet>
    An unexpected error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
