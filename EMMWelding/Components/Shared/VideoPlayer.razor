@*
    A reusable video player.
    Usage:
        <VideoPlayer Src="videos/shop-tour.mp4" Poster="images/shop-tour.jpg" Title="Inside the shop" />

    This component only renders the HTML. The button behavior lives in wwwroot/js/video-player.js,
    because video controls react many times per second and that belongs in the browser, not in C#.
    The <video> starts with the browser's built-in "controls"; the script swaps in ours when it loads,
    so the video still plays even if JavaScript fails.
*@

<div class="vp" data-video-player tabindex="0" role="region" aria-label="@Label" style="max-width: @MaxWidth">

    <video class="vp-video" src="@Src" poster="@Poster" preload="@Preload"
           loop="@Loop" muted="@Muted" playsinline controls>
        Your browser can't play this video. <a href="@Src">Download it instead</a>.
    </video>

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="vp-title">@Title</div>
    }

    <button type="button" class="vp-big-play" data-vp-play aria-label="Play">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9 6.5v11l9-5.5z" /></svg>
    </button>

    <div class="vp-spinner" aria-hidden="true"></div>

    <div class="vp-controls">
        <input type="range" class="vp-seek" data-vp-seek min="0" max="100" step="0.1" value="0" aria-label="Seek" />

        <div class="vp-bar">
            <button type="button" class="vp-btn" data-vp-play aria-label="Play">
                <svg class="vp-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
                <svg class="vp-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
            </button>

            <button type="button" class="vp-btn" data-vp-mute aria-label="Mute">
                <svg class="vp-icon-volume" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M4 9h4l5-4v14l-5-4H4z" />
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16.5 8.5a5 5 0 0 1 0 7" />
                </svg>
                <svg class="vp-icon-muted" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M4 9h4l5-4v14l-5-4H4z" />
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9.5l5 5M21 9.5l-5 5" />
                </svg>
            </button>

            <input type="range" class="vp-volume" data-vp-volume min="0" max="1" step="0.05" value="1" aria-label="Volume" />

            <span class="vp-time">
                <span data-vp-current>0:00</span> / <span data-vp-duration>0:00</span>
            </span>

            <span class="vp-spacer"></span>

            <button type="button" class="vp-btn" data-vp-pip aria-label="Picture-in-picture">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="2" />
                    <rect x="12" y="11" width="7" height="6" rx="1" fill="currentColor" />
                </svg>
            </button>

            @if (AllowDownload)
            {
                <a class="vp-btn" href="@Src" download aria-label="Download video">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                              d="M12 4v10M8 10l4 4 4-4M5 19h14" />
                    </svg>
                </a>
            }

            <button type="button" class="vp-btn" data-vp-fullscreen aria-label="Enter full screen">
                <svg class="vp-icon-enter" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                          d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
                </svg>
                <svg class="vp-icon-exit" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                          d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" />
                </svg>
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>Path to the video, e.g. "videos/shop-tour.mp4" (a file in wwwroot/videos).</summary>
    [Parameter, EditorRequired] public string Src { get; set; } = "";

    /// <summary>Shown across the top of the player, like the Wix title.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Image shown before the video plays, e.g. "images/shop-tour.jpg".</summary>
    [Parameter] public string? Poster { get; set; }

    [Parameter] public bool Loop { get; set; }
    [Parameter] public bool Muted { get; set; }

    /// <summary>"metadata" loads just the length; "none" loads nothing until Play; "auto" starts downloading.</summary>
    [Parameter] public string Preload { get; set; } = "metadata";

    /// <summary>Any CSS width, e.g. "550px". Defaults to filling its container.</summary>
    [Parameter] public string MaxWidth { get; set; } = "100%";

    [Parameter] public bool AllowDownload { get; set; } = true;

    private string Label => $"{Title ?? "Video"} player";
}
